    <apn carrier="Orange Internet"
         mcc="260" mnc="03"
         apn="internet" type="default,supl"
         protocol="IPV4V6" roaming_protocol="IPV4V6" />
    <apn carrier="Orange MMS"
         mcc="260" mnc="03"
         apn="mms" type="mms"
         mmsc="http://mms.orange.pl" proxy="192.168.6.104" port="8080"
         protocol="IPV4V6" />
