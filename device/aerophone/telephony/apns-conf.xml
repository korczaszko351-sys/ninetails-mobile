<?xml version="1.0" encoding="utf-8"?>
<!--
  apns-conf.xml — punkty dostępu (APN) dla polskich operatorów.
  Podzbiór — pełna lista pochodzi od operatorów / AOSP.

  Uwaga: APN dla IMS (VoLTE) i MMS są osobne od domyślnego.
-->
<apns version="8">
