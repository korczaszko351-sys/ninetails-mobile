<?xml version="1.0" encoding="utf-8"?>
<!-- activity_settings.xml — ustawienia AeroRadar -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1420"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="#E8F0FE"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/label_radius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_radius"
            android:textColor="#8FA3BC"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/seek_radius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="11" />

        <CheckBox
            android:id="@+id/check_metric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_units_metric"
            android:textColor="#E8F0FE" />

        <CheckBox
            android:id="@+id/check_alerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_alerts"
            android:textColor="#E8F0FE" />

        <CheckBox
            android:id="@+id/check_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_radar_enabled"
            android:textColor="#E8F0FE" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_endpoint"
            android:textColor="#8FA3BC"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edit_endpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#16222F"
            android:inputType="textUri"
            android:padding="12dp"
            android:textColor="#E8F0FE"
            android:textSize="13sp"
            android:fontFamily="monospace" />

    </LinearLayout>
</ScrollView>
