<?xml version="1.0" encoding="utf-8"?>
<!-- activity_aircraft_detail.xml — ekran Aero ID -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1420"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/detail_title"
            android:textColor="#1A73E8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/detail_icao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#E8F0FE"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="18dp"
            android:background="#1E2C3E" />

        <LinearLayout style="@style/DetailRow">
            <TextView style="@style/DetailLabel" android:text="@string/detail_callsign" />
            <TextView android:id="@+id/detail_callsign" style="@style/DetailValue" />
        </LinearLayout>

        <LinearLayout style="@style/DetailRow">
            <TextView style="@style/DetailLabel" android:text="@string/detail_registration" />
            <TextView android:id="@+id/detail_registration" style="@style/DetailValue" />
        </LinearLayout>

        <LinearLayout style="@style/DetailRow">
            <TextView style="@style/DetailLabel" android:text="@string/detail_type" />
            <TextView android:id="@+id/detail_type" style="@style/DetailValue" />
        </LinearLayout>

        <LinearLayout style="@style/DetailRow">
            <TextView style="@style/DetailLabel" android:text="@string/detail_airline" />
            <TextView android:id="@+id/detail_airline" style="@style/DetailValue" />
        </LinearLayout>

        <LinearLayout style="@style/DetailRow">
            <TextView style="@style/DetailLabel" android:text="@string/detail_route" />
            <TextView android:id="@+id/detail_route" style="@style/DetailValue" />
        </LinearLayout>

        <LinearLayout style="@style/DetailRow">
            <TextView style="@style/DetailLabel" android:text="@string/detail_altitude" />
            <TextView android:id="@+id/detail_altitude" style="@style/DetailValue" />
        </LinearLayout>

        <LinearLayout style="@style/DetailRow">
            <TextView style="@style/DetailLabel" android:text="@string/detail_speed" />
            <TextView android:id="@+id/detail_speed" style="@style/DetailValue" />
        </LinearLayout>

        <LinearLayout style="@style/DetailRow">
            <TextView style="@style/DetailLabel" android:text="@string/detail_distance" />
            <TextView android:id="@+id/detail_distance" style="@style/DetailValue" />
        </LinearLayout>

        <LinearLayout style="@style/DetailRow">
            <TextView style="@style/DetailLabel" android:text="@string/detail_heading" />
            <TextView android:id="@+id/detail_heading" style="@style/DetailValue" />
        </LinearLayout>

        <LinearLayout style="@style/DetailRow">
            <TextView style="@style/DetailLabel" android:text="@string/detail_squawk" />
            <TextView android:id="@+id/detail_squawk" style="@style/DetailValue" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/disclaimer"
            android:textColor="#5A6B80"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
