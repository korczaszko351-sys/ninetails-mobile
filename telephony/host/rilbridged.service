[Unit]
Description=Ninetails Mobile RIL bridge (host ↔ ARCVM)
Documentation=https://github.com/korczaszko351-sys/ninetails-mobile/blob/main/docs/ARCHITECTURE.md
# Startujemy po tym, jak modem jest gotowy i po wirtualizacji
After=systemd-modules-load.service aerophone-modem-ready.service
Wants=aerophone-modem-ready.service
Before=concierge.service arcvm-start.service
# Modem jest zasobem krytycznym — nie restartujmy w pętli
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/rilbridged --port 5000 --modem /dev/qmi0 --backend qmi
Restart=on-failure
RestartSec=5
# Uprawnienia: dostęp do modemu i vsock
User=root
Group=modem
SupplementaryGroups=modem
# Sandbox systemd
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
DeviceAllow=/dev/qmi0 rw
DeviceAllow=/dev/vsock rw
RestrictAddressFamilies=AF_VSOCK AF_UNIX
# Logi do journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rilbridged

# Watchdog: jeśli demon nie odpowie w 60 s, systemd go zrestartuje
WatchdogSec=60

[Install]
WantedBy=multi-user.target
